@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/CoreSQLTargets.cmake")
foreach(component core sql blob vector timestamp spatial json graph date decimal)
  if(TARGET CoreSQL::${component})
    set(CoreSQL_${component}_FOUND TRUE)
  endif()
endforeach()
check_required_components(CoreSQL)
